      "formula": [
        { "t": "動詞て形", "zh": true },
        { "t": "＋", "zh": false },
        { "t": "はいけません", "zh": false }
      ],
      "examples": [
        { "t": "ここで写真を撮ってはいけません。", "hl": "撮ってはいけません", "zh": "这里不可以拍照。" },
        { "t": "教室でたばこを吸ってはいけません。", "hl": "吸ってはいけません", "zh": "不可以在教室里吸烟。" }
      ],
      "note_label": "辨析 · てはいけません 与 ないでください",
      "note": "「てはいけません」表示<b>明令禁止</b>；「ないでください」是较委婉的请求不要做。",
