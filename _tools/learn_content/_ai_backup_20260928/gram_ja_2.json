    {
      "id": "ja_g_l13_tai_desu",
      "lang": "ja",
      "chapter": "ja_l13",
      "kicker": "标日 · 第13課",
      "title": "「～たいです」想做某事",
      "title_sub": "タイ形",
      "formula_label": "句 式 公 式",
      "formula": [
        { "t": "動詞ます形（去ます）", "zh": true },
        { "t": "＋", "zh": false },
        { "t": "たいです", "zh": false }
      ],
      "examples": [
        { "t": "私は日本へ行きたいです。", "hl": "行きたいです", "zh": "我想去日本。" },
        { "t": "水を飲みたいです。", "hl": "飲みたいです", "zh": "我想喝水。" },
        { "t": "彼は新しい車を買いたいです。", "hl": "買いたいです", "zh": "他想买新车。" }
      ],
      "note_label": "辨析 · たい 与 たがる",
      "note": "「たい」只用于<b>第一人称</b>（或询问第二人称）。表示第三人的愿望要用「たがる」或「たがっている」。",
      "page": 13,
      "foot": "初级上 · 第13課"
    },
    {
      "id": "ja_g_l13_ni_ikimasu",
      "lang": "ja",
      "chapter": "ja_l13",
      "kicker": "标日 · 第13課",
      "title": "「～に行きます」去某地做某事",
      "title_sub": "移動の目的",
      "formula_label": "句 式 公 式",
      "formula": [
        { "t": "場所 ＋ へ／に", "zh": true },
        { "t": "＋", "zh": false },
        { "t": "ます形（去ます）", "zh": true },
        { "t": "＋ に行きます", "zh": false }
      ],
      "examples": [
        { "t": "デパートへ買い物に行きます。", "hl": "買い物に行きます", "zh": "去百货商店买东西。" },
        { "t": "図書館へ本を借りに行きます。", "hl": "借りに行きます", "zh": "去图书馆借书。" },
        { "t": "昨日、映画を見に行きました。", "hl": "見に行きました", "zh": "昨天去看电影了。" }
      ],
      "note_label": "辨析 · に行きます 与 へ行きます",
      "note": "「に」前接<b>动词ます形去ます</b>的名词性用法，如「買い物」「見」。若前接名词，则为单纯的移动目的地。",
      "page": 13,
      "foot": "初级上 · 第13課"
    },
    {
      "id": "ja_g_l13_masenka",
      "lang": "ja",
      "chapter": "ja_l13",
      "kicker": "标日 · 第13課",
      "title": "「～ませんか」邀请",
      "title_sub": "ませんか",
      "formula_label": "句 式 公 式",
      "formula": [
        { "t": "動詞ます形", "zh": true },
        { "t": "＋", "zh": false },
        { "t": "ませんか", "zh": false }
      ],
      "examples": [
        { "t": "一緒に昼ご飯を食べませんか。", "hl": "食べませんか", "zh": "要不要一起吃午饭？" },
        { "t": "明日、映画を見ませんか。", "hl": "見ませんか", "zh": "明天要不要看电影？" }
      ],
      "note_label": "辨析 · ませんか 与 ましょうか",
      "note": "「ませんか」是<b>礼貌的邀请</b>，尊重对方意愿；「ましょうか」则多为主动提议或确认。",
      "page": 13,
      "foot": "初级上 · 第13課"
    },
    {
      "id": "ja_g_l14_te_kudasai",
      "lang": "ja",
      "chapter": "ja_l14",
      "kicker": "标日 · 第14課",
      "title": "「～てください」请做某事",
      "title_sub": "テ形",
      "formula_label": "句 式 公 式",
      "formula": [
        { "t": "動詞て形", "zh": true },
        { "t": "＋", "zh": false },
        { "t": "ください", "zh": false }
      ],
      "examples": [
        { "t": "ここに名前を書いてください。", "hl": "書いてください", "zh": "请在这里写上名字。" },
        { "t": "すみません、ちょっと待ってください。", "hl": "待ってください", "zh": "不好意思，请稍等一下。" },
        { "t": "この手紙を出してください。", "hl": "出してください", "zh": "请把这封信寄出去。" }
      ],
      "note_label": "辨析 · てください 与 お～ください",
      "note": "「てください」用于请求对方做某事；更礼貌的说法是「お～ください」。",
      "page": 14,
      "foot": "初级上 · 第14課"
    },
    {
      "id": "ja_g_l14_te_imasu",
      "lang": "ja",
      "chapter": "ja_l14",
      "kicker": "标日 · 第14課",
      "title": "「～ています」动作正在进行",
      "title_sub": "進行",
      "formula_label": "句 式 公 式",
      "formula": [
        { "t": "動詞て形", "zh": true },
        { "t": "＋", "zh": false },
        { "t": "います", "zh": false }
      ],
      "examples": [
        { "t": "李さんは今、本を読んでいます。", "hl": "読んでいます", "zh": "小李现在正在看书。" },
        { "t": "外で雨が降っています。", "hl": "降っています", "zh": "外面正在下雨。" }
      ],
      "note_label": "辨析 · ています 与 います",
      "note": "「ています」表示<b>动作正在进行</b>，也可表示状态的持续或习惯，需根据动词性质判断。",
      "page": 14,
      "foot": "初级上 · 第14課"
    },
    {
      "id": "ja_g_l14_mashouka",
      "lang": "ja",
      "chapter": "ja_l14",
      "kicker": "标日 · 第14課",
      "title": "「～ましょうか」主动提议",
      "title_sub": "ましょうか",
      "formula_label": "句 式 公 式",
      "formula": [
        { "t": "動詞ます形", "zh": true },
        { "t": "＋", "zh": false },
        { "t": "ましょうか", "zh": false }
      ],
      "examples": [
        { "t": "荷物を持ちましょうか。", "hl": "持ちましょうか", "zh": "要我帮您拿行李吗？" },
        { "t": "窓を閉めましょうか。", "hl": "閉めましょうか", "zh": "我来关窗好吗？" }
      ],
      "note_label": "辨析 · ましょうか 与 ませんか",
      "note": "「ましょうか」是说话人<b>主动提出帮忙</b>或提议；「ませんか」则是邀请对方一起做。",
      "page": 14,
      "foot": "初级上 · 第14課"
    },
    {
      "id": "ja_g_l15_temo_ii",
      "lang": "ja",
      "chapter": "ja_l15",
      "kicker": "标日 · 第15課",
      "title": "「～てもいいです」可以做",
      "title_sub": "てもいいです",
      "formula_label": "句 式 公 式",
      "formula": [
        { "t": "動詞て形", "zh": true },
        { "t": "＋", "zh": false },
        { "t": "もいいです", "zh": false }
      ],
      "examples": [
        { "t": "ここに座ってもいいですか。", "hl": "座ってもいいですか", "zh": "我可以坐在这里吗？" },
        { "t": "この写真を見てもいいです。", "hl": "見てもいいです", "zh": "可以看这张照片。" }
      ],
      "note_label": "辨析 · てもいいです 与 てください",
      "note": "「てもいいですか」是<b>请求许可</b>；回答允许用「いいですよ」，拒绝用「ちょっと…」。",
      "page": 15,
      "foot": "初级上 · 第15課"
    },
    {
      "id": "ja_g_l15_tewa_ikemasen",
      "lang": "ja",
