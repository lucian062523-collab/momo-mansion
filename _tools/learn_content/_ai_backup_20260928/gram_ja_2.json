        { "t": "～", "zh": false },
        { "t": "後ろの句", "zh": true }
      ],
      "examples": [
        { "t": "日曜日は掃除して、洗濯します。", "hl": "掃除して", "zh": "星期天打扫卫生，然后洗衣服。" },
