      "formula_label": "句 式 公 式",
      "formula": [
        { "t": "動詞て形", "zh": true },
        { "t": "＋", "zh": false },
        { "t": "から", "zh": false }
      ],
      "examples": [
        { "t": "仕事が終わってから、飲みに行きます。", "hl": "終わってから", "zh": "工作结束后去喝酒。" },
        { "t": "よく考えてから、返事をします。", "hl": "考えてから", "zh": "仔细考虑之后再答复。" },
        { "t": "朝ご飯を食べてから、学校へ行きます。", "hl": "食べてから", "zh": "吃完早饭再去学校。" }
